# Deployment
# Private key for the deployer wallet. Never commit real secrets.
DEPLOYER_PRIVATE_KEY=

# Arbiscan API key to verify contracts
# Get one at: https://arbiscan.io/myapikey
ARBISCAN_API_KEY=

# Frontend
# Contract address after deployment
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Network: arbitrumSepolia | arbitrumOne
NEXT_PUBLIC_NETWORK=arbitrumSepolia

# Arbitrum Sepolia public RPC. Use Alchemy/Infura for production traffic if needed.
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Tokens on Arbitrum Sepolia testnet
NEXT_PUBLIC_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# Local risk agent
# Ollama endpoint, only useful in local development.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional fallback API key, only if your agent code uses it server-side.
# ANTHROPIC_API_KEY=
